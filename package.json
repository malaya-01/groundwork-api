{
  "name": "groundwork-api",
  "version": "0.1.0",
  "private": true,
  "description": "Groundwork backend: NestJS + TypeORM + PostgreSQL (Supabase)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "node --import tsx --test \"src/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typeorm": "typeorm-ts-node-commonjs -d src/db/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/db/data-source.ts",
    "migration:run": "ts-node src/db/migrate-cli.ts",
    "migration:run:prod": "node dist/db/migrate-cli.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/db/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/db/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
