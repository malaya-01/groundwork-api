# Copy this file to .env and fill in the values. Never commit .env.

# Supabase Postgres. Get it from Supabase → Project → Connect → "Session pooler" (port 5432).
# Use the Session pooler: it works on IPv4 networks. The direct host db.<ref>.supabase.co is
# IPv6-only and fails on most home/office networks with "getaddrinfo ENOTFOUND".
# (The transaction pooler on port 6543 also works, but session mode suits a long-running server.)
# If your password has special characters (@ : / ? # %), URL-encode them.
# Do not add ?sslmode=... to the URL; SSL is controlled by DB_SSL below.
DATABASE_URL=postgresql://postgres.tgyoautofhjikvqmdxta:YOUR-DATABASE-PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_MAX=5

# Long random string (at least 32 characters) used to sign login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

PORT=4000
# Where the web app runs (CORS). Comma-separate several.
WEB_ORIGIN=http://localhost:3000
# Set to true when served over HTTPS in production.
COOKIE_SECURE=false

# Reading books: one or more Markdown library roots (comma-separated), each with seed/books.json.
# The API only reads these files, never writes them.
LIBRARY_DIR=D:/Books/rapture
